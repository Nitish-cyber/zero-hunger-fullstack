{
  "name": "zero-hunger-fullstack",
  "version": "1.0.0",
  "description": "Zero Hunger Fullstack MERN Application",
  "scripts": {
    "install-backend": "npm install --prefix backend",
    "install-frontend": "npm install --prefix frontend --include=dev --production=false",
    "build-frontend": "npm run build --prefix frontend",
    "build": "npm run install-backend && npm run install-frontend && npm run build-frontend",
    "start": "npm start --prefix backend"
  }
}
